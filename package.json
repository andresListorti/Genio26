{
  "name": "zapateria-genaro-api",
  "version": "1.0.0",
  "description": "Shoe e-commerce API (Zapateria Genaro) — Express + Firebase + PayPal",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "check:paypal": "ts-node-dev --transpile-only src/scripts/check-paypal.ts",
    "check:mercadopago": "ts-node-dev --transpile-only src/scripts/check-mercadopago.ts",
    "check:mercadopago:payment": "ts-node-dev --transpile-only src/scripts/check-mercadopago-payment.ts",
    "verify": "npm run typecheck && npm run check:paypal && npm run check:mercadopago && npm run check:mercadopago:payment",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ecommerce",
    "shoes",
    "express",
    "firebase",
    "paypal"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "mercadopago": "^3.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/paypal__checkout-server-sdk": "^1.0.8",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
